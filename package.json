{
  "name": "multisite",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
 "scripts": {
  "dev": "npm run dev:all",

  "dev:aamir": "npm run dev --workspace=apps/aamir -- --host 0.0.0.0 --port 5173 --strictPort",
  "dev:umair": "npm run dev --workspace=apps/umair -- --host 0.0.0.0 --port 5174 --strictPort",
  "dev:main": "npm run dev --workspace=apps/main -- --host 0.0.0.0 --port 5175 --strictPort",
  "dev:admin": "npm run dev --workspace=apps/admin -- --host 0.0.0.0 --port 5176 --strictPort",

  "dev:kundler2": "npm run dev --workspace=apps/kundler2 -- --host 0.0.0.0 --port 5177 --strictPort",
  "dev:kundler": "npm run dev --workspace=apps/kundler -- --host 0.0.0.0 --port 5178 --strictPort",
  "dev:frankfurt": "npm run dev --workspace=apps/frankfurt-intern -- --host 0.0.0.0 --port 5179 --strictPort",
  "dev:tierisch": "npm run dev --workspace=apps/tierisch -- --host 0.0.0.0 --port 5180 --strictPort",

  "dev:server": "npm run dev --workspace=packages/server-api",

  "build:aamir": "npm run build --workspace=apps/aamir",
  "build:umair": "npm run build --workspace=apps/umair",
  "build:main": "npm run build --workspace=apps/main",
  "build:admin": "npm run build --workspace=apps/admin",
  "build:kundler2": "npm run build --workspace=apps/kundler2",
  "build:kundler": "npm run build --workspace=apps/kundler",
  "build:frankfurt": "npm run build --workspace=apps/frankfurt-intern",
  "build:tierisch": "npm run build --workspace=apps/tierisch",

  "build": "npm run build:kundler2",

"dev:all": "concurrently -n aamir,umair,main,admin,kundler2,frankfurt,tierisch,server \"npm run dev:aamir\" \"npm run dev:umair\" \"npm run dev:main\" \"npm run dev:admin\" \"npm run dev:kundler2\" \"npm run dev:frankfurt\" \"npm run dev:tierisch\" \"npm run dev:server\""
},
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
